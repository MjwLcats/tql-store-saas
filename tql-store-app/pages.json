{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录",
        "backgroundColor": "#FFFFFF",
        "enablePullDownRefresh": false,
        // 新增：禁用页面滚动（对 App、H5 均有效）
        "disableScroll": true,
        // 新增：App 专用配置
        "app-plus": {
          // 禁用 iOS/Android 弹性滚动
          "bounce": "none",
          // 禁用侧滑返回手势
          "popgesture": "none"
        }
      }
    },
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "门店运营",
        "backgroundColor": "#F7F8FA",
        "enablePullDownRefresh": false,
        "app-plus": {
          "background": "#EAF4FF",
          "bounce": "vertical",
          "pullToRefresh": {
            "support": true,
            "color": "#165DFF",
            "height": "52px",
            "range": "78px",
            "offset": "44px",
            "contentdown": {
              "caption": "下拉刷新"
            },
            "contentover": {
              "caption": "松开刷新"
            },
            "contentrefresh": {
              "caption": "正在刷新…"
            }
          }
        }
      }
    },
    {
      "path": "pages/content-tasks/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "内容任务",
        "backgroundColor": "#F7F8FA",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/content-tasks/detail",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "任务详情",
        "backgroundColor": "#F7F8FA",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/content-tasks/player",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "样例视频",
        "backgroundColor": "#05070D",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/inventory/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "盘点任务",
        "backgroundColor": "#F7F8FA",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/inventory/count",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "盘点录入",
        "backgroundColor": "#F7F8FA",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "tql-store-app",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF"
  },
  "uniIdRouter": {}
}
