# Copy this file to .env.local. Never commit real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tql_store_saas
MYSQL_USERNAME=tql_store_app
MYSQL_PASSWORD=replace-with-a-secret

# Optional shared infrastructure
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
NACOS_DISCOVERY_ENABLED=false
