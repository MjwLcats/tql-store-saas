<template>
  <view class="shell">
    <view v-if="activeTab===0" class="screen home-screen">
      <view class="home-head"><text class="greeting">早上好，{{displayName}}</text><button class="store-line" @click="showStore">当前门店：{{storeName}} ›</button></view>
      <view class="overview">
        <view class="section-head"><text class="section-title">今日任务</text><button class="link" @click="openTaskList('ALL')">查看全部 ›</button></view>
        <view class="stats">
          <view class="stat-block"><text class="stat-value">{{total}}</text><text class="stat-label">全部</text></view>
          <view class="stat-block"><text class="stat-value stat-value--orange">{{todoCount}}</text><text class="stat-label">待完成</text></view>
          <view class="stat-block"><text class="stat-value stat-value--blue">{{processingCount}}</text><text class="stat-label">进行中</text></view>
          <view class="stat-block"><text class="stat-value stat-value--red">{{pausedCount}}</text><text class="stat-label">已暂停</text></view>
        </view>
      </view>
      <view class="task-section">
        <view class="section-head section-head--task"><text class="section-title">任务列表</text><button class="link" @click="loadTasks(true)">刷新</button></view>
        <view v-if="loading" class="empty">正在加载任务…</view>
        <view v-else-if="tasks.length===0" class="empty">暂无待处理任务</view>
        <view v-else class="task-list"><button v-for="task in tasks.slice(0,6)" :key="String(task['id'])" class="task-row" hover-class="task-row--pressed" @click="openTask(task)">
            <view class="task-copy">
              <view class="task-title-line"><text class="task-title">{{taskName(task)}}</text><text class="type">{{creationLabel(task)}}</text></view><text class="task-meta">{{taskActivity(task)}} · {{deadline(task)}}</text>
            </view>
            <view class="task-side"><text class="status" :class="'status--'+tone(task)">{{statusLabel(task)}}</text><text class="arrow">›</text></view>
          </button></view>
      </view>
    </view>

    <view v-else-if="activeTab===1" class="screen standard-screen">
      <view class="page-heading"><text class="page-title">分析</text><text class="page-subtitle">门店运营数据概览</text></view>
      <view class="open-panel"><text class="panel-title">功能建设中</text><text class="panel-copy">后续接入内容任务完成率、发布数据和门店执行趋势。</text></view>
    </view>

    <view v-else-if="activeTab===2" class="screen standard-screen">
      <view class="page-heading"><text class="page-title">任务</text><text class="page-subtitle">集中处理门店执行任务</text></view><button class="feature-row" @click="openTaskList('TODO')">
        <view class="feature-main"><text class="feature-title">AI短视频任务</text><text class="feature-copy">查看拍摄、成片、发布和回传进度</text></view><text class="feature-count">{{todoCount}} ›</text>
      </button><button class="feature-row" @click="openInventory">
        <view class="feature-main"><text class="feature-title">盘点任务</text><text class="feature-copy">录入物料实盘数量并提交审核</text></view><text class="arrow">›</text>
      </button>
    </view>

    <view v-else-if="activeTab===3" class="screen standard-screen">
      <view class="page-heading"><text class="page-title">应用</text><text class="page-subtitle">常用门店工具</text></view>
      <view class="app-list"><button class="app-row" @click="openTaskList('ALL')">
          <view class="app-icon app-icon--blue"><text>视</text></view>
          <view class="feature-main"><text class="feature-title">AI短视频</text><text class="feature-copy">员工内容任务工作台</text></view><text class="arrow">›</text>
        </button><button class="app-row" @click="openInventory">
          <view class="app-icon app-icon--orange"><text>盘</text></view>
          <view class="feature-main"><text class="feature-title">盘点</text><text class="feature-copy">门店物料盘点录入</text></view><text class="arrow">›</text>
        </button></view>
    </view>

    <view v-else class="screen standard-screen">
      <view class="profile">
        <view class="avatar"><text>{{displayName.slice(0,1)}}</text></view>
        <view><text class="profile-name">{{displayName}}</text><text class="profile-meta">{{mobile}} · 门店员工</text></view>
      </view>
      <view class="setting-list"><button class="setting-row" @click="showPending('账号与安全')"><text>账号与安全</text><text>›</text></button><button class="setting-row" @click="openAuthorization"><text>三方平台授权</text><text>›</text></button><button class="setting-row" @click="showPending('消息设置')"><text>消息设置</text><text>›</text></button><button class="setting-row" @click="showPending('帮助与反馈')"><text>帮助与反馈</text><text>›</text></button>
        <view class="setting-row"><text>关于平台</text><text class="muted">v1.0.0</text></view>
      </view><button class="logout" @click="handleLogout">退出登录</button>
    </view>

    <app-tab-bar :active-index="activeTab" @change="setActiveTab" />
  </view>
</template>

<script lang="uts">
  import {
    fetchContentTasks
  } from '@/api/content-tasks.uts'
  import {
    logout
  } from '@/api/auth.uts'
  import {
    clearSession,
    getSession
  } from '@/utils/auth.uts'
  import {
    contentCreationLabel,
    formatDeadline,
    stageTone,
    taskDisplayStage,
    taskPlanStatus,
    taskStatusLabel
  } from '@/utils/content-task.uts'
  import AppTabBar from '@/components/app-tab-bar/app-tab-bar.uvue'

	function valueText(value: any): string {
		return value == null ? '' : String(value)
	}

	function firstText(values: any[]): string {
		for (let index = 0; index < values.length; index++) {
			const value = valueText(values[index]).trim()
			if (value.length > 0) return value
		}
		return ''
	}

  export default {
    components: {
      AppTabBar
    },
    data() {
      return {
        activeTab: 0,
        loading: false,
        tasks: [] as UTSJSONObject[],
        total: 0,
        session: null as any | null
      }
    },
    computed: {
      user(): UTSJSONObject {
        return this.session != null && this.session['user'] != null
          ? this.session['user'] as UTSJSONObject
          : ({} as UTSJSONObject)
      },
      displayName(): string {
        return firstText([this.user['displayName'], this.user['username'], '同庆楼员工'])
      },
      mobile(): string {
        return firstText([this.user['mobile'], this.user['phone']])
      },
      storeName(): string {
        return firstText([this.user['primaryStoreName'], this.user['storeName'], '未选择门店'])
      },
      todoCount(): number {
        return this.tasks.filter((item: UTSJSONObject) => valueText(item['category']) === 'TODO' || ['READY_TO_SHOOT', 'SHOOTING', 'NEEDS_REVISION'].includes(valueText(item['stage']))).length
      },
      processingCount(): number {
        return this.tasks.filter((item: UTSJSONObject) => ['PROCESSING', 'PENDING_REVIEW', 'READY_TO_PUBLISH'].includes(valueText(item['stage']))).length
      },
      pausedCount(): number {
        return this.tasks.filter((item: UTSJSONObject) => taskPlanStatus(item) === 'PAUSED').length
      }
    },
    onLoad() {
      this.session = getSession();
      if (this.session == null) {
        uni.reLaunch({
          url: '/pages/index/index'
        });
        return
      }
      this.loadTasks(true)
    },
    onShow() {
      if (this.session != null) this.loadTasks(false)
    },
    onPullDownRefresh() {
      this.loadTasks(false).finally(() => uni.stopPullDownRefresh())
    },
    methods: {
      async loadTasks(showLoading: boolean) {
        if (showLoading) this.loading = true;
        try {
          const result = await fetchContentTasks('ALL', 1, 100);
		  this.tasks = (result['records'] as UTSJSONObject[] | null) ?? [];
		  this.total = Number(result['total'] ?? this.tasks.length)
        } catch (error: any) {
          if (showLoading) uni.showToast({
            title: error != null && error.message != null ? String(error.message) : '任务加载失败',
            icon: 'none'
          })
        } finally {
          this.loading = false
        }
      },
      setActiveTab(index: number) {
        if (index < 0 || index > 4) return;
        this.activeTab = index
      },
      openTask(task: UTSJSONObject) {
        uni.navigateTo({
          url: '/pages/content-tasks/detail?id=' + encodeURIComponent(String(task['id']))
        })
      },
      openTaskList(category: string) {
        uni.navigateTo({
          url: '/pages/content-tasks/index?category=' + category
        })
      },
      openInventory() {
        const storeId = Number(this.user['primaryStoreId'] ?? this.user['storeId'] ?? 0);
        uni.navigateTo({
          url: '/pages/inventory/index?storeId=' + storeId
        })
      },
      openAuthorization() {
        uni.navigateTo({
          url: '/pages/platform-authorizations/index'
        })
      },
      creationLabel(task: UTSJSONObject): string {
        return contentCreationLabel(task)
      },
      taskName(task: UTSJSONObject): string {
        return firstText([task['planName'], '未命名任务'])
      },
      taskActivity(task: UTSJSONObject): string {
        return firstText([task['activityName'], 'AI短视频'])
      },
      statusLabel(task: UTSJSONObject): string {
        return taskStatusLabel(task)
      },
      tone(task: UTSJSONObject): string {
        return stageTone(taskDisplayStage(task))
      },
      deadline(task: UTSJSONObject): string {
		return formatDeadline(valueText(task['deadline']))
      },
      showStore() {
        uni.showToast({
          title: this.storeName,
          icon: 'none'
        })
      },
      showPending(label: string) {
        uni.showToast({
          title: label + '功能建设中',
          icon: 'none'
        })
      },
      handleLogout() {
        uni.showModal({
          title: '退出登录',
          content: '确定退出当前账号吗？',
          confirmColor: '#165DFF',
          success: async (result: ShowModalSuccess) => {
            if (!result.confirm) return
            try {
              await logout()
            } catch (_error: any) {}
            clearSession()
            uni.reLaunch({
              url: '/pages/index/index'
            })
          }
        })
      }
    }
  }
</script>

<style>
  .shell {
    height: 100%;
    background: #f5f7fa;
    color: #1d2129;
    font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif
