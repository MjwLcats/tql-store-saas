<template>
	<view class="tabbar-wrap" aria-label="主导航">
		<view class="tabbar">
			<view
				v-for="(item, index) in tabs"
				:key="item.text"
				class="tab-item"
				:class="{ 'tab-item--active': activeIndex === index }"
				hover-class="tab-item--pressed"
				hover-start-time="0"
				hover-stay-time="80"
				:aria-label="item.text"
				@click="select(index)"
			>
				<text class="tab-label" :class="{ 'tab-label--active': activeIndex === index }">{{ item.text }}</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		name: 'AppTabBar',
		props: {
			activeIndex: { type: Number, default: 0 }
		},
		data() {
			return {
				tabs: [
					{ text: '首页' },
					{ text: '分析' },
					{ text: '任务' },
					{ text: '应用' },
					{ text: '我的' }
				]
			}
		},
		methods: {
			select(index) {
				if (index === this.activeIndex || !this.tabs[index]) return
				this.$emit('change', index)
			},
		}
	}
</script>

<style>
	.tabbar-wrap {
		position: fixed;
		z-index: 999;
		left: 0;
		right: 0;
		bottom: 0;
		box-sizing: border-box;
		padding-bottom: 40rpx;
		border-top: 1rpx solid #eef0f3;
		background: #ffffff;
		font-family: "PingFang SC", "PingFangSC-Regular", "Helvetica Neue", Arial, sans-serif;
	}

	.tabbar {
		position: relative;
		flex-direction: row;
		box-sizing: border-box;
		width: 100%;
		height: 104rpx;
		padding: 6rpx 20rpx 4rpx;
		background: transparent;
	}

	.tab-item {
		flex: 1;
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		min-width: 0;
		height: 100%;
		margin: 0;
		padding: 0;
		border-width: 0;
		border-radius: 0;
		background-color: transparent;
		color: #666a72;
		line-height: 1;
	}

	.tab-label {
		font-family: "PingFang SC", "PingFangSC-Regular", "Helvetica Neue", Arial, sans-serif;
		font-size: 25rpx;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.2rpx;
		white-space: nowrap;
		transition: color 160ms ease, font-weight 160ms ease, opacity 120ms ease, transform 120ms ease;
	}

	.tab-label--active {
		color: #165dff;
		font-weight: 600;
	}

	.tab-item--pressed { opacity: 0.68; }

</style>
